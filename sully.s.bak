global main
extern sprintf
extern fopen
extern fclose
extern system
extern fprintf
section .text
main:
    push rbp
    mov rbp, rsp
    mov r13, [rel num]
    lea rdi, [rel filename]
    lea rsi, [rel name]
    mov rdx, r13
    xor eax, eax
    call sprintf wrt ..plt
    dec r13d
    cmp r13d, 0
    jl .exit
    lea rdi, [rel filename]
    lea rsi, [rel mode]
    call fopen wrt ..plt
    mov r12, rax
    mov rdi, r12
    lea rsi, [rel quine]
    mov rdx, 10
    mov rcx, 10
    mov r8, 10
    mov r9, 10
    push 10
    push 10
    push 10
    push 34
    lea rax, [rel quine]
    push rax
    push 34
    push 10
    push 34
    push 34
    push 10
    push 34
    movsx rax, r13d
    push 34
    push 10
    push 34
    movsx rax, r13d
    push 34
    push 10
    push 10
    push rax
    %rep 67
        push 10
    %endrep
    xor eax, eax
    call fprintf wrt ..plt
    lea rdi, [rel buffer]
    lea rsi, [rel fmt]
    mov edx, r13d
    xor eax, eax
    call sprintf wrt ..plt
    lea rdi, [rel buffer]
    call system wrt ..plt
    mov rdi, r12
    call fclose wrt ..plt
    xor eax, eax
    leave
    ret
.exit:
    xor eax, eax
    leave
    ret
section .data
num: dd 5
section .rodata
fmt: db "nasm -f elf64 sully_%d.s -o sully.o && gcc sully.o -o sully && ./sully", 0
name: db "sully_%d.s", 0
mode: db "w", 0
quine: db "global main%cextern sprintf%cextern fopen%cextern fclose%cextern system%cextern fprintf%csection .text%cmain:%c    push rbp%c%c    mov rbp, rsp%c    mov r13, [rel num]%c    lea rdi, [rel filename]%c    lea rsi, [rel name]%c    mov rdx, r13%c    xor eax, eax%c    call sprintf wrt ..plt%c    dec r13d%c    cmp r13d, 0%c    jl .exit%c    lea rdi, [rel filename]%c    lea rsi, [rel mode]%c    call fopen wrt ..plt%c    mov r12, rax%c    mov rdi, r12%c    lea rsi, [rel quine]%c    mov rdx, 10%c    mov rcx, 10%c    mov r8, 10%c    mov r9, 10%c    push 10%c    push 10%c    push 10%c    push 34%c    lea rax, [rel quine]%c    push 34%c    push 10%c    push 34%c    push 34%c    push 10%c    push 34%c    movsx rax, r13d%c    push 34%c    push 10%c    push 34%c    movsx rax, r13d%c    push 34%c    push 10%c    push 10%c    push rax%c    %%rep 67%c        push 10%c    %%endrep%c    xor eax, eax%c    call fprintf wrt ..plt%c    lea rdi, [rel buffer]%c    lea rsi, [rel fmt]%c    mov edx, r13d%c    xor eax, eax%c    call sprintf wrt ..plt%c    lea rdi, [rel buffer]%c    call system wrt ..plt%c    mov rdi, r12%c    call fclose wrt ..plt%c    xor eax, eax%c    leave%c    ret%c.exit:%c    xor eax, eax%c    leave%c    ret%csection .data%cnum: dd %d%csection .rodata%cfmt: db %cnasm -f elf64 sully_%d.s -o sully.o && gcc sully.o -o sully && ./sully%c, 0%cname: db %csully_%d.s%c, 0%cmode: db %cw%c, 0%cquine: db %c%s%c, 0%csection .bss%cfilename: resb 100%cbuffer: resb 100", 0
section .bss
filename: resb 100
buffer: resb 100
